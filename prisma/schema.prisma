generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  // Session pooler requires pgbouncer mode for Prisma
}

model User {
  id                       String                    @id @default(cuid())
  name                     String?
  email                    String                    @unique
  password                 String?
  role                     String                    @default("seeker")
  active                   Boolean                   @default(true)
  emailVerified            Boolean                   @default(false)
  verificationToken        String?                   @unique
  verificationTokenExpiry  DateTime?
  // A six-digit code is a million guesses, and a day to make them. Counting
  // failures is what turns it from theatre into a lock.
  verificationAttempts     Int                       @default(0)
  // Consent to marketing, kept separate from the terms checkbox on purpose:
  // bundled consent is not consent under GDPR, PECR, or CASL, and users here
  // will not all be in one country. The timestamp is the evidence it was given.
  marketingOptIn           Boolean                   @default(false)
  marketingOptInAt         DateTime?
  premium                  Boolean                   @default(false)
  premiumSince             DateTime?
  premiumUntil             DateTime?
  stripeCustomerId         String?
  stripeSubscriptionId     String?
  notificationPreferences  String? // JSON string for notification preferences
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  seekerProfile            SeekerProfile?
  employerProfile          EmployerProfile?
  savedProfiles            SavedProfile[]
  contactsSent             ContactRequest[]
  jobNeeds                 JobNeed[]
  needInterests            NeedInterest[]
  reviewsGiven             Review[]                  @relation("GivenReviews")
  reportsGiven             Report[]                  @relation("GivenReports")
  notifications            Notification[]
  reportResponses          ReportResponse[]
  profileViewsMade         ProfileView[]             @relation("ProfileViewer")
  savedSearches            SavedSearch[]
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]
  foundingMemberNumber     Int?                      @unique // null = not a founding member, 1-250 = their number
  activityEvents           ActivityEvent[]           @relation("activityActor")
  hiresAsEmployer          Hire[]                    @relation("EmployerHires")
  hiresAsSeeker            Hire[]                    @relation("SeekerHires")
  hireReviews              HireReview[]
  sandboxAccess            SandboxAccess[]
  gcashPayments            GcashPayment[]
  sponsorshipsGiven        Sponsorship[]             @relation("SponsorshipsGiven")
  referralsMade            Referral[]                @relation("ReferralsMade")
  scenarioAttempts         ScenarioAttempt[]
  testimonials             Testimonial[]
  // Earned by having a testimonial approved. Employers filter on it,
  // which is what makes it worth having rather than decorative.
  placedBadgeAt            DateTime?
  referralCode             String?                   @unique
}

model SeekerProfile {
  id               String           @id @default(cuid())
  userId           String           @unique
  username         String           @unique
  avatarUrl        String?
  // Optional, and optional means invisible: a profile without one has no
  // banner area at all rather than a grey placeholder announcing the gap.
  coverUrl         String?
  bio              String?
  location         String?
  hourlyRate       Float?
  rateType         String           @default("hourly") // "hourly" or "monthly"
  availability     String           @default("open")
  englishRating    Int              @default(5)
  openToWork       Boolean          @default(true)
  featured         Boolean          @default(false)
  profileViews     Int              @default(0)
  title            String?
  videoIntroUrl    String?
  timezone         String?
  lastActiveAt     DateTime?
  // Their own channel, on their own terms. Shown to signed-in visitors only —
  // a phone number on a page open to the whole internet is a number that gets
  // scraped and sold, and that harm lands on the member, not on us.
  whatsapp         String?
  linkedinUrl      String?
  githubUrl        String?
  twitterUrl       String?
  facebookUrl      String?
  instagramUrl     String?
  portfolioUrl     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills           SeekerSkill[]
  savedBy          SavedProfile[]
  contactsReceived ContactRequest[] @relation("ReceiverContacts")
  portfolioLinks   PortfolioLink[]
  certificates     Certificate[]
  projectImages    ProjectImage[]
  languages        Language[]
  reviewsReceived  Review[]
  reports          Report[]
  viewHistory      ProfileView[]
}

model ProfileView {
  id              String        @id @default(cuid())
  seekerProfileId String
  viewerUserId    String
  createdAt       DateTime      @default(now())
  viewerUser      User          @relation("ProfileViewer", fields: [viewerUserId], references: [id], onDelete: Cascade)
  seekerProfile   SeekerProfile @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)
}

model Skill {
  id           String        @id @default(cuid())
  name         String        @unique
  slug         String        @unique
  category     String
  isCustom     Boolean       @default(false)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  seekerSkills SeekerSkill[]
}

model SeekerSkill {
  id        String        @id @default(cuid())
  profileId String
  skillId   String
  rating    Int
  yearsExp  Float?
  profile   SeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill     Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([profileId, skillId])
}

model SavedProfile {
  id         String        @id @default(cuid())
  employerId String
  profileId  String
  createdAt  DateTime      @default(now())
  employer   User          @relation(fields: [employerId], references: [id], onDelete: Cascade)
  profile    SeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([employerId, profileId])
}

model ContactRequest {
  id          String        @id @default(cuid())
  senderId    String
  receiverId  String
  message     String
  senderEmail String
  status      String        @default("pending")
  createdAt   DateTime      @default(now())
  sender      User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  receiver    SeekerProfile @relation("ReceiverContacts", fields: [receiverId], references: [id], onDelete: Cascade)
}

model AdSlot {
  id         String    @id @default(cuid())
  name       String
  placement  String
  imageUrl   String
  linkUrl    String
  altText    String
  active     Boolean   @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  // Higher wins the slot. Ads sharing a priority take turns, so two
  // advertisers who paid the same both get a fair share rather than one
  // sitting permanently under the other by accident of upload order.
  priority   Int       @default(0)
  clickCount Int       @default(0)
  viewCount  Int       @default(0)
  advertiser String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model PortfolioLink {
  id        String        @id @default(cuid())
  profileId String
  label     String
  url       String
  order     Int           @default(0)
  profile   SeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Certificate {
  id        String        @id @default(cuid())
  profileId String
  name      String
  issuer    String
  year      Int?
  imageUrl  String?
  createdAt DateTime      @default(now())
  profile   SeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ProjectImage {
  id          String        @id @default(cuid())
  profileId   String
  title       String
  description String?
  imageUrl    String
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  profile     SeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Language {
  id        String        @id @default(cuid())
  profileId String
  name      String
  level     String        @default("conversational")
  profile   SeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model JobNeed {
  id           String         @id @default(cuid())
  employerId   String
  employer     User           @relation(fields: [employerId], references: [id], onDelete: Cascade)
  title        String
  description  String
  category     String
  skills       String
  minRate      Float?
  maxRate      Float?
  availability String         @default("open")
  status       String         @default("active")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  interests    NeedInterest[]
  hires        Hire[]
}

model NeedInterest {
  id        String   @id @default(cuid())
  needId    String
  seekerId  String
  message   String?
  createdAt DateTime @default(now())
  need      JobNeed  @relation(fields: [needId], references: [id], onDelete: Cascade)
  seeker    User     @relation(fields: [seekerId], references: [id], onDelete: Cascade)

  @@unique([needId, seekerId])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model EmployerProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  companyName      String?
  website          String?
  // Same reasoning as the seeker side: a way to take a conversation off the
  // platform when both people want to, visible only to signed-in visitors.
  whatsapp         String?
  linkedIn         String?
  description      String?
  logoUrl          String?
  verified         Boolean   @default(false)
  verifiedAt       DateTime?
  newEmployer      Boolean   @default(true)
  // Verification tier: "partner" = self-serve $12.99, "vf_verified" = admin-awarded after consultation
  verificationTier String?
  // Partner-only fields
  industry         String?
  companySize      String?
  location         String?
  foundedYear      Int?
  techStack        String?
  benefits         String?
  cultureStatement String?
  videoIntroUrl    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewsReceived  Review[]  @relation("EmployerReviews")
  reports          Report[]  @relation("ReportedEmployer")
}

model Review {
  id                String           @id @default(cuid())
  reviewerUserId    String
  type              String
  rating            Int
  comment           String?
  seekerProfileId   String?
  employerProfileId String?
  createdAt         DateTime         @default(now())
  reviewerUser      User             @relation("GivenReviews", fields: [reviewerUserId], references: [id], onDelete: Cascade)
  seekerProfile     SeekerProfile?   @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)
  employerProfile   EmployerProfile? @relation("EmployerReviews", fields: [employerProfileId], references: [id], onDelete: Cascade)

  @@unique([reviewerUserId, seekerProfileId])
  @@unique([reviewerUserId, employerProfileId])
}

model Report {
  id                String           @id @default(cuid())
  reporterUserId    String
  reportedUserId    String?
  reportedJobId     String?
  reason            String
  description       String?
  status            String           @default("pending")
  seekerProfileId   String?
  employerProfileId String?
  createdAt         DateTime         @default(now())
  reviewedAt        DateTime?
  reporter          User             @relation("GivenReports", fields: [reporterUserId], references: [id], onDelete: Cascade)
  seekerProfile     SeekerProfile?   @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)
  employerProfile   EmployerProfile? @relation("ReportedEmployer", fields: [employerProfileId], references: [id], onDelete: Cascade)
  response          ReportResponse?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  actionUrl String?
  relatedId String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReportResponse {
  id        String   @id @default(cuid())
  reportId  String   @unique
  userId    String
  message   String
  createdAt DateTime @default(now())
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SkillSearch {
  id        String   @id @default(cuid())
  skillName String
  category  String?
  createdAt DateTime @default(now())
}

model SavedSearch {
  id           String    @id @default(cuid())
  employerId   String
  name         String
  search       String?
  category     String?
  availability String?
  minRate      Float?
  maxRate      Float?
  minEnglish   Int?
  lastNotified DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  employer     User      @relation(fields: [employerId], references: [id], onDelete: Cascade)
}

model Conversation {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  messages     Message[]
  participants ConversationParticipant[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  content        String
  createdAt      DateTime     @default(now())
  conversationId String
  senderId       String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])
}

model Hire {
  id         String       @id @default(cuid())
  employerId String
  seekerId   String
  jobNeedId  String?
  status     String       @default("active") // active, completed, cancelled
  title      String
  startDate  DateTime     @default(now())
  endDate    DateTime?
  rateAgreed Float?
  rateType   String? // hourly, monthly, fixed
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  employer   User         @relation("EmployerHires", fields: [employerId], references: [id], onDelete: Cascade)
  seeker     User         @relation("SeekerHires", fields: [seekerId], references: [id], onDelete: Cascade)
  jobNeed    JobNeed?     @relation(fields: [jobNeedId], references: [id], onDelete: SetNull)
  reviews    HireReview[]
}

model HireReview {
  id         String   @id @default(cuid())
  hireId     String
  reviewerId String
  rating     Int // 1-5
  comment    String?
  type       String // "employer_to_seeker" or "seeker_to_employer"
  createdAt  DateTime @default(now())
  hire       Hire     @relation(fields: [hireId], references: [id], onDelete: Cascade)
  reviewer   User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([hireId, reviewerId])
}

model ActivityEvent {
  id        String   @id @default(cuid())
  type      String
  actorId   String?
  actor     User?    @relation("activityActor", fields: [actorId], references: [id], onDelete: SetNull)
  metadata  String?
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ── Sandbox access ─────────────────────────────────────────────────────────
//
// Four ways in, deliberately. Spencer: "I don't want to be the gatekeeper."
// Someone earning 8,000 pesos a month should not be locked out of the thing
// that gets them hired, so paying is one route of four rather than the route.
//
//   paid       — 100 pesos by GCash, buys 30 days. One-time, not a
//                subscription: most people here have no card, and a
//                subscription mandate is a barrier before it is a payment.
//   earned     — three scenarios finished and their quizzes passed, which buys
//                another 30 days. NOT free entry: everyone pays to start, and
//                the extension is earned by doing the work we want them doing
//                anyway. It is also the only route that verifies itself.
//   sponsored  — somebody funds a seat for somebody else. An employer, or a
//                friend, or anyone with the means. Not gated to employers:
//                Spencer's point was that the person paying and the person
//                learning need not know each other.
//   referred   — two people join on your link, you get a month. The link only
//                exists once you have paid for a seat yourself, so it cannot
//                be farmed by people who never turned up.
//
// Every grant is a fixed window with an end date. Nothing renews by itself,
// so nobody is ever charged for a month they forgot about — which matters
// more at this price point than it would at any other.

enum AccessSource {
  paid
  earned
  sponsored
  referred
  comped
}

enum PaymentState {
  awaiting_proof
  awaiting_check
  verified
  rejected
}

model SandboxAccess {
  id         String        @id @default(cuid())
  userId     String
  source     AccessSource
  startsAt   DateTime      @default(now())
  expiresAt  DateTime
  subAccount String? // which GHL sub-account they were put in
  note       String?
  grantedBy  String? // the VA or admin who approved it
  createdAt  DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment    GcashPayment?

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

// A claimed GCash transfer, waiting for a human to confirm it arrived.
//
// Deliberately manual. Automating reconciliation against GCash needs a
// business account Spencer does not have yet, and a VA checking a reference
// number against the app takes about fifteen seconds. The queue is the
// product until volume says otherwise.
model GcashPayment {
  id           String         @id @default(cuid())
  userId       String
  reference    String // the GCash reference number they typed in
  amount       Int            @default(100)
  proofUrl     String? // screenshot, in Supabase storage
  state        PaymentState   @default(awaiting_proof)
  checkedBy    String?
  checkedAt    DateTime?
  rejectReason String?
  createdAt    DateTime       @default(now())
  accessId     String?        @unique
  access       SandboxAccess? @relation(fields: [accessId], references: [id])
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reference])
  @@index([state, createdAt])
}

// An employer buying seats for people they have never met.
model Sponsorship {
  id        String   @id @default(cuid())
  sponsorId String // the employer's User id
  seats     Int
  seatsUsed Int      @default(0)
  note      String? // "for anyone doing the bookkeeping track"
  createdAt DateTime @default(now())
  sponsor   User     @relation("SponsorshipsGiven", fields: [sponsorId], references: [id], onDelete: Cascade)

  @@index([sponsorId])
}

// Bring two, get a month.
//
// The code lives on the user and is only issued once they have paid for a
// seat, so a link cannot be handed out by someone who never joined. A referral
// only counts when the invited person's own seat is granted — an account that
// signs up and never pays is not a referral, it is a name.
model Referral {
  id         String   @id @default(cuid())
  referrerId String
  invitedId  String   @unique
  qualified  Boolean  @default(false) // the invited person got a seat
  rewarded   Boolean  @default(false) // the referrer has been paid out
  createdAt  DateTime @default(now())
  referrer   User     @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId, qualified, rewarded])
}

// Three scenarios, marked, buying the next thirty days.
//
// Auto-graded, which is the point: it is the only one of the four routes that
// needs nobody to check anything, and it scales past the volume a VA could.
model ScenarioAttempt {
  id          String   @id @default(cuid())
  userId      String
  scenarioKey String // which scenario, e.g. "media-buying-01"
  score       Int // percent
  passed      Boolean
  answers     Json? // kept so a disputed mark can be looked at
  submittedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scenarioKey])
  @@index([userId, passed])
}

// A resource is anything that hangs off a video: the scenario brief people
// practise against, the spreadsheet they fill in, the recording itself. Videos
// and documents share one table because the resources page shows them together
// and sorting them apart in the UI is easier than joining two tables that
// always appear side by side.
enum ResourceKind {
  video
  document
  scenario
}

model Resource {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  summary     String?
  track       String // "GoHighLevel", "Media Buying", "Bookkeeping" — free text so a new track needs no migration
  kind        ResourceKind
  videoUrl    String? // YouTube watch URL, for kind = video
  filePath    String? // Supabase storage path, for kind = document or scenario
  fileName    String?
  fileSize    Int?
  // Drafts are the default. A resource going live the moment it uploads means a
  // half-written scenario is public while it is being written.
  published   Boolean      @default(false)
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([track, published, position])
  @@index([published, createdAt])
}

// A testimonial from somebody Spencer actually placed. This is the platform's
// answer to the one question a business owner asks first — is this real — and
// it is the reason the reward for writing one is generous rather than symbolic.
enum TestimonialState {
  pending
  approved
  rejected
}

model Testimonial {
  id           String           @id @default(cuid())
  userId       String
  body         String
  // What they do and who for. Both optional: some placements are under NDA and
  // a testimonial with no company still beats no testimonial at all.
  roleTitle    String?
  company      String?
  // Shown as "worked with us since March 2026" rather than a star rating —
  // duration is harder to fake and means more to somebody deciding to hire.
  placedSince  DateTime?
  consentPublic Boolean         @default(true)
  state        TestimonialState @default(pending)
  featured     Boolean          @default(false)
  reviewNote   String?
  reviewedBy   String?
  reviewedAt   DateTime?
  // The reward is granted exactly once, on first approval. Re-approving an
  // edited testimonial must not pay out a second month.
  rewardedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([state, createdAt])
  @@index([userId])
}
